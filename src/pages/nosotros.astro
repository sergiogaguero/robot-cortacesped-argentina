---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CTAFinal from "@/components/CTAFinal.astro";
import IconCheck from "@/components/icons/IconCheck.astro";
import { site } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ldAboutPage, ldBreadcrumb } from "@/lib/schema";
import { absoluteUrl } from "@/lib/seo";

const title = "Quiénes somos | Robot Cortacésped Argentina";
const description = "Vendemos robots cortacésped con IA en Argentina: asesoramiento por WhatsApp, envíos a todo el país, garantía del fabricante y soporte técnico local.";
const crumbs = [
  { name: "Inicio", href: "/" },
  { name: "Quiénes somos", href: "/nosotros" },
];
const jsonLd = [
  ldBreadcrumb(crumbs.map((c) => ({ name: c.name, url: absoluteUrl(c.href) }))),
  ldAboutPage({ url: absoluteUrl("/nosotros"), description }),
];
const pasos = [
  { t: "Nos escribís por WhatsApp", d: "Nos contás cuántos metros tiene tu jardín, si hay árboles, canteros o pendientes. Si querés, nos mandás fotos." },
  { t: "Te recomendamos un modelo", d: "Te decimos si un robot tiene sentido para tu jardín y cuál conviene. Si no conviene, también te lo decimos." },
  { t: "Te pasamos el precio del día", d: "Te confirmamos el precio en pesos, la disponibilidad y el plazo de entrega a tu domicilio." },
  { t: "Lo recibís en tu casa", d: "Enviamos a toda la Argentina y te ayudamos con la instalación de la base, el mapeo y la app." },
];
const garantias = ["Garantía del fabricante en todos los equipos", "Soporte técnico local, en tu idioma y por WhatsApp", "Ayuda con la instalación, la configuración y el mantenimiento", "Envíos a todo el país"];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap pt-24 pb-8 lg:pt-32">
    <div class="mx-auto max-w-3xl">
      <Breadcrumbs items={crumbs} />
      <p class="mb-3 text-xs font-semibold tracking-widest text-primary uppercase">Quiénes somos</p>
      <h1 class="mb-6 text-3xl leading-tight font-bold md:text-5xl">Robots cortacésped con IA, con atención de acá</h1>
      <div class="space-y-5 text-lg leading-relaxed text-muted-foreground">
        <p><strong class="text-foreground">{site.name}</strong> vende robots cortacésped en la Argentina. Trabajamos con robots cortacésped que se guían con cámaras e inteligencia artificial: reconocen el césped, los bordes y los obstáculos, y cortan solos, sin cable perimetral enterrado ni antenas.</p>
        <p>Elegimos trabajar con TerraMow porque su navegación por cámara es la que mejor se adapta al jardín típico argentino, con árboles, canteros y quincho: se instala sin obra y se adapta si cambiás el diseño del jardín. Lo explicamos en detalle en <a href="/tecnologia" class="text-primary hover:underline">cómo funciona</a> y en la <a href="/blog/camara-ia-vs-rtk-vs-lidar-robot-cortacesped" class="text-primary hover:underline">comparativa de tecnologías</a>.</p>
        <p>No tenemos tienda online: preferimos hablar con cada persona, entender su jardín y recomendar solo lo que le sirve.</p>
      </div>

      <h2 class="mt-16 mb-6 text-2xl font-bold md:text-3xl">Cómo trabajamos</h2>
      <ol class="space-y-4">
        {pasos.map((p, i) => (
          <li class="flex gap-4 rounded-2xl border border-border bg-card p-5">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-foreground">{i + 1}</span>
            <div><h3 class="mb-1 font-semibold">{p.t}</h3><p class="text-muted-foreground">{p.d}</p></div>
          </li>
        ))}
      </ol>

      <h2 class="mt-16 mb-6 text-2xl font-bold md:text-3xl">Después de la compra</h2>
      <ul class="space-y-3">
        {garantias.map((g) => <li class="flex items-center gap-3"><IconCheck class="shrink-0 text-primary" size={20} /><span>{g}</span></li>)}
      </ul>

      <h2 class="mt-16 mb-6 text-2xl font-bold md:text-3xl">Contacto</h2>
      <ul class="space-y-2 text-muted-foreground">
        <li><strong class="text-foreground">WhatsApp:</strong> {site.whatsapp.display}</li>
        <li><strong class="text-foreground">Email:</strong> <a href={`mailto:${site.email}`} class="text-primary hover:underline">{site.email}</a></li>
        <li><strong class="text-foreground">Instagram:</strong> <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">@robotscortacesped_argentina</a></li>
        <li><strong class="text-foreground">Ubicación:</strong> {site.location.locality}, Argentina. Envíos a todo el país.</li>
      </ul>
    </div>
  </div>
  <CTAFinal wa="nosotros-cta" />
</BaseLayout>
